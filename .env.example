# ─── Required ────────────────────────────────────────────────────────────────

# Google Gemini API (used for embeddings via the google-genai client)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API (used for the LLM and Whisper speech-to-text — free tier)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# ─── Optional: MongoDB ───────────────────────────────────────────────────────
# Without these the API still runs; tickets simply are not persisted.
# Leave a variable out entirely to use its default — a blank value is treated
# as unset, so `MONGODB_URI=` falls back to localhost rather than erroring.
#
# Local:            mongodb://localhost:27017
# Atlas free tier:  mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=customer_support


# ─── Optional: Gmail SMTP notifications ──────────────────────────────────────
# Requires 2FA on the account plus an App Password (NOT your login password).
# Generate one at: https://myaccount.google.com/apppasswords
# Omit these to disable outbound email; ticket creation still works.
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Support team inbox that receives new-ticket alerts
DEVELOPER_EMAIL=support_team@company.com


# ─── Optional: paths ─────────────────────────────────────────────────────────
# Override only if your data or index lives somewhere else.
DATA_PATH=data/customer_support_tickets.csv
VECTOR_STORE_PATH=vector_store
